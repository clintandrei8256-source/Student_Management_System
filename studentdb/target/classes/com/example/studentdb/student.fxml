<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="555.0" prefWidth="448.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.studentdb.Controller">
    <center>
        <VBox BorderPane.alignment="CENTER">
            <children>
                <TextField fx:id="txtName" promptText="Name">
               <VBox.margin>
                  <Insets bottom="10.0" />
               </VBox.margin></TextField>
                <ChoiceBox fx:id="cbYear" prefHeight="25.0" prefWidth="248.0">
               <VBox.margin>
                  <Insets bottom="10.0" />
               </VBox.margin></ChoiceBox>
                <TextField fx:id="txtCourse" promptText="Course">
               <VBox.margin>
                  <Insets bottom="10.0" />
               </VBox.margin></TextField>
                <HBox alignment="CENTER" layoutX="10.0" layoutY="60.0" spacing="10.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#addStudent" prefHeight="25.0" prefWidth="95.0" text="Add" />
                        <Button mnemonicParsing="false" onAction="#updateStudent" prefHeight="25.0" prefWidth="95.0" text="Update" />
                        <Button mnemonicParsing="false" onAction="#deleteStudent" prefHeight="25.0" prefWidth="95.0" text="Delete" />
                        <Button mnemonicParsing="false" onAction="#clearFields" prefHeight="25.0" prefWidth="95.0" text="Clear" />
                    </children>
               <VBox.margin>
                  <Insets bottom="10.0" />
               </VBox.margin>
                </HBox>
            <Label text="Student Data">
               <padding>
                  <Insets bottom="5.0" />
               </padding>
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </Label>
                <TableView fx:id="table">
                    <columns>
                  <TableColumn fx:id="colId" prefWidth="53.0" text="ID" />
                        <TableColumn fx:id="colName" prefWidth="232.0" text="Name" />
                        <TableColumn fx:id="colYear" prefWidth="78.0" text="Year Level" />
                  <TableColumn fx:id="colCourse" prefWidth="64.0" text="Course" />
                    </columns>
                </TableView>
            </children>
        </VBox>
    </center>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</BorderPane>
